# Токен от @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Публичный HTTPS-адрес сервера мини-аппа (ngrok, Caddy, свой домен).
# Без него мини-апп не работает — останется только ручной ввод времени.
WEBAPP_URL=https://xxxx.ngrok-free.app

# Порт локального HTTP-сервера мини-аппа
HTTP_PORT=8080

# Куда складывать временные файлы
DATA_DIR=data
